{
  "name": "proofops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first diagnostics for Attestcoin workflows",
  "bin": {
    "proofops": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json",
    "start": "node dist/cli.js dashboard",
    "dev": "npm run build && npm start",
    "doctor": "node dist/cli.js doctor",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@gluwa/usc-sdk": "0.18.0",
    "ethers": "6.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
